NODE_ENV=development
API_PORT=3000
MCP_PORT=3001
DATABASE_PATH=./data/app.db
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
ALLOW_HEADER_AUTH=true
EXEC_RATE_LIMIT_PER_MIN=30
EXEC_MAX_CONCURRENT=2
EXEC_TIMEOUT_MS=30000
EXEC_RETENTION_DAYS=90
